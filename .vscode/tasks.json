{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ReGameDLL: build Linux",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build/regamedll-linux.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "detail": "Builds upstream ReGameDLL_CS for Linux x86 and copies cs.so into mod/modcsbr/dlls."
    },
    {
      "label": "ReGameDLL: check Windows environment",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/test/check-windows-environment.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "Checks Git, VS Code, MSVC, MSBuild, and ReGameDLL_CS paths on Windows."
    },
    {
      "label": "ReGameDLL: build Windows Release Win32",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build/regamedll-windows.ps1",
        "-Configuration",
        "Release",
        "-Platform",
        "Win32"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Builds upstream ReGameDLL_CS with MSBuild as Release | Win32 for Windows diagnostics."
    },
    {
      "label": "modcsbr: install into Steam CS 1.6 Windows",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/install/modcsbr-steam-windows.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "Installs liblist.gam, mp.dll, and copied assets into the Windows Steam Half-Life/modcsbr folder."
    },
    {
      "label": "modcsbr: launch Steam CS 1.6 Windows",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/test/launch-modcsbr-steam-windows.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "Installs and launches Half-Life through Steam with -game modcsbr on Windows."
    },
    {
      "label": "modcsbr: install into Steam CS 1.6",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/install/modcsbr-steam-linux.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "Installs liblist.gam, cs.so, and asset links into the Steam Half-Life/modcsbr folder."
    },
    {
      "label": "modcsbr: launch Steam CS 1.6",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/test/launch-modcsbr-steam-linux.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Launches hl_linux with -game modcsbr."
    }
  ]
}
